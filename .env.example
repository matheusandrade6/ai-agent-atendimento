ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# A aplicacao usa um papel SEM privilegio: superusuario ignora RLS (ver D-09).
DATABASE_URL=postgresql+asyncpg://datamind_app:datamind_app@localhost:5433/datamind
# Dono das tabelas, so para migrations.
DATABASE_ADMIN_URL=postgresql+asyncpg://datamind:datamind@localhost:5433/datamind
REDIS_URL=redis://localhost:6380/0

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_EXTRACTION_MODEL=claude-haiku-4-5-20251001

# WhatsApp Cloud API
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Token de sistema da Business Manager, usado no envio. Um token cobre varios WABAs;
# o que separa um tenant do outro e o phone_number_id da config (ver D-16).
# Sem ele o worker de saida nao envia — em desenvolvimento isso e o esperado.
WHATSAPP_ACCESS_TOKEN=

# Seguranca — trocar obrigatoriamente fora do ambiente local
SECRET_KEY=dev-only-change-me
SLOT_TOKEN_SECRET=dev-only-change-me

# Observabilidade
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
